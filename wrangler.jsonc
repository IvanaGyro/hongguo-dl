{
  "name": "hongguo-dl",
  "main": "./worker/entry.js",
  "compatibility_date": "2026-11-11",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // Run near Tokyo so App API calls (search, episode directory, sources) leave
  // from Japan: the App filters some series for Taiwan/Hong Kong IPs.
  "placement": { "region": "aws:us-west-2" },
  "previews": {}
}
