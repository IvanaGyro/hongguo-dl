{
  "name": "hongguo-dl",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prebuild": "node scripts/copy-ffmpeg.mjs",
    "build": "vite build",
    "dev": "vite --host",
    "dev:worker": "wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run test && npm run build"
  },
  "dependencies": {
    "@ffmpeg/core": "0.12.10",
    "@ffmpeg/ffmpeg": "0.12.15"
  },
  "devDependencies": {
    "vite": "^6.3.5",
    "wrangler": "^4.45.0"
  }
}
