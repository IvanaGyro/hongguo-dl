{
  "name": "hongguo-dl",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun scripts/copy-ffmpeg.mjs && vite build",
    "dev": "vite --host",
    "dev:worker": "wrangler dev",
    "deploy:worker": "wrangler deploy",
    "test": "bun test tests/unit",
    "check": "bun run test && bun run build && bunx wrangler deploy --dry-run --outdir /tmp/hongguo-worker"
  },
  "dependencies": {
    "@ffmpeg/core": "0.12.10",
    "@ffmpeg/ffmpeg": "0.12.15",
    "@fontsource-variable/chiron-goround-tc": "5.3.1",
    "@videojs/html": "10.3.0",
    "@videojs/media": "10.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "vite": "^6.3.5",
    "wrangler": "^4.45.0"
  },
  "packageManager": "bun@1.3.3"
}
